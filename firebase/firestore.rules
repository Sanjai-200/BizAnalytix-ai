// Firestore Security Rules for BizAnalytix AI
//
// IMPORTANT: The Flask backend uses the Firebase ADMIN SDK, which bypasses
// these rules completely. The Admin SDK has full read/write access to
// Firestore regardless of what is written here. That means these rules do
// NOT protect data from the Flask backend itself — protection against
// cross-user access is enforced in Flask (every query is scoped to the
// authenticated UID taken from the verified ID token).
//
// These rules exist as a second layer of defense in case any part of the
// app is ever accessed directly from the browser with the Firebase client
// SDK (bypassing Flask). They ensure that even in that case, a user can
// only read/write documents under their own users/{uid} path.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // Profile writes (role changes etc.) should only happen through the
      // Flask backend (Admin SDK), so client writes are disabled here.
      allow write: if false;

      match /datasets/{datasetId} {
        allow read, delete: if isOwner(uid);
        allow write: if false; // uploads go through Flask only

        match /records/{recordId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      match /chats/{chatId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
