# ---------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file or the service account key.
# ---------------------------------------------------------

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-string

# Path to the Firebase service account JSON key file (downloaded from
# Firebase Console > Project Settings > Service Accounts).
# Keep this file OUT of GitHub (already covered by .gitignore).
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json

# Gemini API key (from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name. Change here if a model becomes deprecated.
GEMINI_MODEL=gemini-flash-latest

# Comma-separated emails that should automatically become "admin"
# the first time they log in. Use your own email(s) here.
ADMIN_EMAILS=admin@example.com

# Practical free-tier limits (safe to leave as-is)
MAX_FILE_SIZE_MB=5
MAX_UPLOAD_ROWS=5000
MAX_CONTEXT_ROWS=20
MAX_CHAT_HISTORY=10

# How many of a user's own datasets get combined automatically into a
# single question when they haven't clicked one specific dataset first.
MAX_DATASETS_IN_CONTEXT=5
